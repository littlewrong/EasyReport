VITE_BASE=/erbiui/

# 接口地址
VITE_GLOB_API_URL=/erbiapi
VITE_GLOB_HTTP_DATASOURCE_API_URL=/erdsapi/http
VITE_GLOB_SQL_DATASOURCE_API_URL=/erdsapi/sql
VITE_GLOB_PYTHON_DATASOURCE_API_URL=/erdsapi/python

# BI 大屏设计器地址
VITE_BI_DESIGNER_URL=/erbidesigner/index.html

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
