[Unit]
Description=ER-BI FastAPI backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/application/bi/api
Environment=PYTHONUNBUFFERED=1
Environment=APP_CONFIG=/application/bi/api/config.ini
ExecStart=/usr/bin/python39 -m uvicorn app.main:app --host 0.0.0.0 --port 5320 --workers 4 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
